QMainWindow {
    background-color: #f5f5f5;
}

QPushButton {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 3px;
    padding: 8px 16px;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #45a049;
}

QTextEdit, QLineEdit, QSpinBox {
    border: 1px solid #ddd;
    border-radius: 3px;
    padding: 5px;
    background-color: white;
}

QTextEdit:focus, QLineEdit:focus, QSpinBox:focus {
    border-color: #4CAF50;
}